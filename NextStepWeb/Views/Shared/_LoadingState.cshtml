<section class="loading-container" id="loadingExperience">
    <div class="loading-pulse-ring" aria-hidden="true"></div>
    <h2 class="loading-title" id="loadingTitle">Analyzing Your Situation</h2>
    <div class="loading-message" id="loadingMessageText">
        Understanding your situation...
    </div>
    <span class="loading-timer-badge" id="loadingTimerSeconds">0s elapsed</span>
    <p style="font-size: var(--font-size-xs); color: var(--color-text-muted); margin-top: var(--space-3); margin-bottom: 0;">
        Your input is preserved. Please do not close this window.
    </p>
</section>
